<https://glossarist.org/fixtures/concept/minimal> a gloss:Concept, skos:Concept ;
  gloss:identifier "1.1" ;
  gloss:hasStatus gloss:status\/valid ;
  gloss:hasLocalization <https://glossarist.org/fixtures/concept/minimal/eng> .

<https://glossarist.org/fixtures/concept/minimal/eng> a gloss:LocalizedConcept, skos:Concept ;
  gloss:language "eng" ;
  gloss:hasEntryStatus gloss:entstatus\/valid ;
  gloss:isLocalizationOf <https://glossarist.org/fixtures/concept/minimal> ;
  skosxl:prefLabel <https://glossarist.org/fixtures/concept/minimal/eng/desig/minimal_concept> ;
  skos:prefLabel "minimal concept"@eng ;
  skos:definition "A minimal concept used to verify the baseline emission path."@eng ;
  gloss:hasDefinition [ rdf:type gloss:DetailedDefinition ; rdf:value "A minimal concept used to verify the baseline emission path."@eng ] .

<https://glossarist.org/fixtures/concept/minimal/eng/desig/minimal_concept> a gloss:Expression, skosxl:Label ;
  skosxl:literalForm "minimal concept"@eng ;
  gloss:normativeStatus gloss:norm\/preferred .