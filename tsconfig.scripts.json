{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noImplicitAny": false,
    "strict": false,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true
  },
  "include": [
    "scripts/**/*.ts",
    "cli/**/*.ts",
    "cli/**/*.mjs"
  ],
  "exclude": [
    "scripts/__tests__/**",
    "node_modules/**"
  ]
}
