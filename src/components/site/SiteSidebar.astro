---
import { getCollection } from 'astro:content';
import { getSiteConfig } from '../../lib/site-config';

interface Props { activeDataset?: string; activeGroup?: string }
const { activeDataset, activeGroup } = Astro.props;

const datasets = await getCollection('datasets');
const groups = await getCollection('groups');
const siteConfig = await getSiteConfig();
---
<aside id="sidebar" class="hidden lg:block w-64 shrink-0 border-r border-ink-100/60 dark:border-ink-700/40 min-h-[calc(100vh-3.5rem)] p-3">
  <nav class="space-y-4 text-sm">
    <a href="/" class={`block px-2 py-1.5 rounded ${!activeDataset && !activeGroup ? 'bg-blue-50 dark:bg-blue-900/20 text-blue-700 dark:text-blue-300' : 'text-ink-600 dark:text-ink-300 hover:bg-ink-50 dark:hover:bg-ink-800/40'}`}>
      Home
    </a>
    <a href="/search" class="block px-2 py-1.5 rounded text-ink-600 dark:text-ink-300 hover:bg-ink-50 dark:hover:bg-ink-800/40">Search</a>
    <a href="/graph" class="block px-2 py-1.5 rounded text-ink-600 dark:text-ink-300 hover:bg-ink-50 dark:hover:bg-ink-800/40">Graph</a>

    {groups.length > 0 ? (
      groups.map(g => (
        <div>
          <a href={`/group/${g.data.id}`} class={`block px-2 py-1.5 font-medium rounded ${activeGroup === g.data.id ? 'bg-blue-50 dark:bg-blue-900/20 text-blue-700 dark:text-blue-300' : 'text-ink-700 dark:text-ink-200 hover:bg-ink-50 dark:hover:bg-ink-800/40'}`}>
            {g.data.label}
          </a>
          <ul class="mt-1 space-y-0.5 ml-2">
            {g.data.datasets.map((id: string) => {
              const ds = datasets.find(d => d.data.id === id);
              if (!ds) return null;
              return (
                <li>
                  <a href={`/dataset/${id}`} class={`block px-2 py-1 rounded text-xs ${activeDataset === id ? 'bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-300 font-medium' : 'text-ink-500 dark:text-ink-400 hover:bg-ink-50 dark:hover:bg-ink-800/30'}`}>
                    {ds.data.title.length > 28 ? ds.data.title.slice(0, 25) + '…' : ds.data.title}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    ) : (
      <div>
        <h3 class="px-2 py-1 text-xs font-semibold text-ink-400 uppercase tracking-wider">Datasets</h3>
        <ul class="space-y-0.5">
          {datasets.map(ds => (
            <li>
              <a href={`/dataset/${ds.data.id}`} class={`block px-2 py-1 rounded text-xs ${activeDataset === ds.data.id ? 'bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-300 font-medium' : 'text-ink-500 dark:text-ink-400 hover:bg-ink-50 dark:hover:bg-ink-800/30'}`}>
                {ds.data.title.length > 28 ? ds.data.title.slice(0, 25) + '…' : ds.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </nav>
</aside>
