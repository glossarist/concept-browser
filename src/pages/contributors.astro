---
import AppLayout from '../layouts/Default.astro';
import { getSiteConfig } from '../lib/site-config';
const config = await getSiteConfig();
const contributors = config.contributors || [];
---

<AppLayout title="Contributors">
  <h1 class="text-2xl font-bold text-ink-800 dark:text-ink-100 mb-6">Contributors</h1>
  {contributors.length > 0 ? (
    <ul class="space-y-3">
      {contributors.map(c => (
        <li class="card p-4 flex items-center gap-4">
          <div class="w-10 h-10 rounded-full bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center text-blue-600 dark:text-blue-300 font-bold">
            {(c.name || '?')[0]}
          </div>
          <div>
            <div class="font-medium text-ink-800 dark:text-ink-100">{c.name}</div>
            {c.role && <div class="text-xs text-ink-400">{c.role}{c.organization ? ` · ${c.organization}` : ''}</div>}
          </div>
        </li>
      ))}
    </ul>
  ) : <p class="text-ink-400">No contributor information available.</p>}
</AppLayout>
