---
import AppLayout from '../../layouts/Default.astro';
---

<AppLayout title="Ontology Schema">
  <h1 class="text-2xl font-bold text-ink-800 dark:text-ink-100 mb-4">Ontology Schema</h1>
  <p class="text-ink-500 dark:text-ink-400">Browse the Glossarist ontology classes and properties.</p>
  <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="card p-4"><h3 class="font-medium">gloss:Concept</h3><p class="text-xs text-ink-400 mt-1">A terminology concept</p></div>
    <div class="card p-4"><h3 class="font-medium">gloss:LocalizedConcept</h3><p class="text-xs text-ink-400 mt-1">A language-specific localization</p></div>
    <div class="card p-4"><h3 class="font-medium">gloss:Designation</h3><p class="text-xs text-ink-400 mt-1">A term or symbol</p></div>
    <div class="card p-4"><h3 class="font-medium">gloss:DetailedDefinition</h3><p class="text-xs text-ink-400 mt-1">A reified definition</p></div>
  </div>
</AppLayout>
