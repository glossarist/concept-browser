---
import AppLayout from '../../../../layouts/Default.astro';
import ConceptIsland from '../../../../islands/ConceptIsland.vue';
import NonVerbalIsland from '../../../../islands/NonVerbalIsland.vue';
import BibliographyIsland from '../../../../islands/BibliographyIsland.vue';
import { getEntry, getCollection } from 'astro:content';

export async function getStaticPaths() {
  const concepts = await getCollection('concepts');
  return concepts.map(c => ({
    params: { id: c.data.registerId, cid: c.data.conceptId },
    props: { conceptData: c.data },
  }));
}

const { id, cid } = Astro.params;
const { conceptData } = Astro.props;
const dataset = await getEntry('datasets', id!);
---

<AppLayout title={conceptData ? `${conceptData.designations.eng ?? cid} — ${dataset?.data.title ?? ''}` : cid} activeDataset={id}>
  <div class="mb-4 text-xs text-ink-400">
    <a href={`/dataset/${id}`} class="hover:text-blue-600">{dataset?.data.title}</a>
    <span class="mx-1">›</span>
    <span>{cid}</span>
  </div>

  <!-- Concept island uses REAL SPA components (DesignationList, NonVerbalRepDisplay,
       FormatDownloads, ConceptRdfView). client:only="vue" skips SSR because the
       components access Pinia stores + glossarist/rdf (Node-only) that can't
       server-render. The island hydrates client-side with full functionality. -->
  <ConceptIsland
    client:only="vue"
    concept={conceptData}
    registerId={id}
    conceptUri={conceptData?.uri ?? ''}
  />

  <!-- Static fallback content (shown before hydration, for SEO/no-JS) -->
  <noscript>
    <h1 class="text-2xl font-bold">{conceptData?.designations?.eng ?? cid}</h1>
    <p class="text-ink-500">{conceptData?.definition?.eng ?? ''}</p>
  </noscript>
</AppLayout>

<script>
  // Keyboard shortcuts (TODO 24: accessibility)
  document.addEventListener('keydown', (e) => {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
    if (e.key === 's' || e.key === 'S') {
      window.location.href = '/search';
    } else if (e.key === 'h' || e.key === 'H') {
      window.location.href = '/';
    } else if (e.key === '?') {
      alert('Keyboard shortcuts:\n  S — Search\n  H — Home\n  ? — This help');
    }
  });
</script>
