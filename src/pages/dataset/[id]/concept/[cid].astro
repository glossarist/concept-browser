---
import AppLayout from '../../../../layouts/Default.astro';
import ConceptIsland from '../../../../islands/ConceptIsland.vue';
import NonVerbalIsland from '../../../../islands/NonVerbalIsland.vue';
import BibliographyIsland from '../../../../islands/BibliographyIsland.vue';
import { getEntry, getCollection } from 'astro:content';

export async function getStaticPaths() {
  const concepts = await getCollection('concepts');
  return concepts.map(c => ({
    params: { id: c.data.registerId, cid: c.data.conceptId },
    props: { conceptData: c.data },
  }));
}

const { id, cid, conceptData } = Astro.props;
const dataset = await getEntry('datasets', id!);
---

<AppLayout title={conceptData ? `${conceptData.designations.eng ?? cid} — ${dataset?.data.title ?? ''}` : cid} activeDataset={id}>
  <div class="mb-4 text-xs text-ink-400">
    <a href={`/dataset/${id}`} class="hover:text-blue-600">{dataset?.data.title}</a>
    <span class="mx-1">›</span>
    <span>{cid}</span>
  </div>

  <ConceptIsland
    client:load
    concept={conceptData}
    registerId={id}
  />

  <NonVerbalIsland
    client:visible
    nonVerbalReps={(conceptData as any)?.nonVerbalReps}
    registerId={id}
  />

  <BibliographyIsland
    client:visible
    entries={(conceptData as any)?.bibliography ?? []}
  />
</AppLayout>

<script>
  // Keyboard shortcuts (TODO 24: accessibility)
  document.addEventListener('keydown', (e) => {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
    if (e.key === 's' || e.key === 'S') {
      window.location.href = '/search';
    } else if (e.key === 'h' || e.key === 'H') {
      window.location.href = '/';
    } else if (e.key === '?') {
      alert('Keyboard shortcuts:\n  S — Search\n  H — Home\n  ? — This help');
    }
  });
</script>
