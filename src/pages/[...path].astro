---
import AppLayout from '../layouts/Default.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const datasets = await getCollection('datasets');
  const paths = [
    { params: { path: 'ontology' } },
    { params: { path: 'about' } },
    { params: { path: 'contributors' } },
    { params: { path: 'news' } },
    /* /learn and sub-routes — page-types.ts auto-synthesizes the nav entry.
       Without these static paths the nav link 404s on prefetch (issue #174). */
    { params: { path: 'learn' } },
    { params: { path: 'learn/relationships' } },
    { params: { path: 'learn/designations' } },
    { params: { path: 'learn/statuses' } },
  ];
  for (const ds of datasets) {
    paths.push({ params: { path: `dataset/${ds.data.id}/about` } });
    paths.push({ params: { path: `dataset/${ds.data.id}/stats` } });
    paths.push({ params: { path: `dataset/${ds.data.id}/sources` } });
    for (const g of await getCollection('groups')) {
      paths.push({ params: { path: `group/${g.data.id}/about` } });
    }
  }
  return paths;
}

const datasets = await getCollection('datasets');
const title = datasets.length > 0 ? datasets[0].data.title : 'Concept Browser';
---

<AppLayout title={title} />
