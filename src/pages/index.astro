---
import DefaultLayout from '../layouts/Default.astro';
import { getCollection } from 'astro:content';

const datasets = await getCollection('datasets');
const groups = await getCollection('groups');

const siteConfig = {
  title: 'Geolexica',
  subtitle: 'Terminology Register',
};
---

<DefaultLayout title={siteConfig.title} description="A terminology register for ISO and IEC standards.">
  <div class="max-w-7xl mx-auto px-4 py-8">
    <header class="mb-8">
      <h1 class="text-3xl font-bold text-ink-800 dark:text-ink-100">{siteConfig.title}</h1>
      <p class="text-lg text-ink-500 dark:text-ink-400 mt-1">{siteConfig.subtitle}</p>
    </header>

    {groups.length > 0 ? (
      <section class="space-y-8">
        {groups.map(group => (
          <div class="group-section">
            <h2 class="text-xl font-semibold text-ink-700 dark:text-ink-200 mb-3">
              {group.data.label}
            </h2>
            {group.data.description && (
              <p class="text-sm text-ink-400 dark:text-ink-500 mb-4">{group.data.description}</p>
            )}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              {group.data.datasets.map(id => {
                const ds = datasets.find(d => d.data.id === id);
                if (!ds) return null;
                return (
                  <a
                    href={`/dataset/${ds.data.id}`}
                    class="card p-5 hover:shadow-md transition-shadow"
                  >
                    <h3 class="font-medium text-ink-800 dark:text-ink-100">{ds.data.title}</h3>
                    <p class="text-sm text-ink-500 dark:text-ink-400 mt-1 line-clamp-2">{ds.data.description}</p>
                    <div class="mt-3 flex items-center gap-3 text-xs text-ink-400">
                      <span>{ds.data.conceptCount} concepts</span>
                      {ds.data.year && <span>· {ds.data.year}</span>}
                      <span>· {ds.data.languages.join(', ')}</span>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        ))}
      </section>
    ) : (
      <section>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {datasets.map(ds => (
            <a href={`/dataset/${ds.data.id}`} class="card p-5 hover:shadow-md transition-shadow">
              <h3 class="font-medium text-ink-800 dark:text-ink-100">{ds.data.title}</h3>
              <p class="text-sm text-ink-500 dark:text-ink-400 mt-1 line-clamp-2">{ds.data.description}</p>
              <div class="mt-3 flex items-center gap-3 text-xs text-ink-400">
                <span>{ds.data.conceptCount} concepts</span>
                {ds.data.year && <span>· {ds.data.year}</span>}
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</DefaultLayout>
