---
import AppLayout from '../layouts/Default.astro';
import { getCollection } from 'astro:content';

const datasets = await getCollection('datasets');
const totalConcepts = datasets.reduce((sum, d) => sum + (d.data.conceptCount || 0), 0);
const title = datasets.length > 0 ? datasets[0].data.title : 'Concept Browser';
---

<AppLayout title={title} description={`${totalConcepts} concepts across ${datasets.length} datasets`} />
