---
import AppLayout from '../../layouts/Default.astro';
import { getCollection } from 'astro:content';
const pages = await getCollection('pages');
const news = pages.filter(p => p.data.type === 'news');
---

<AppLayout title="News">
  <h1 class="text-2xl font-bold text-ink-800 dark:text-ink-100 mb-4">News</h1>
  {news.length > 0 ? (
    <ul class="space-y-4">
      {news.map(n => (
        <li class="card p-4">
          <h2 class="font-semibold text-ink-800 dark:text-ink-100">{n.data.title}</h2>
        </li>
      ))}
    </ul>
  ) : <p class="text-ink-400">No news articles.</p>}
</AppLayout>
