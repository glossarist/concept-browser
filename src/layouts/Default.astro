---
import '@/styles/tailwind.css';
import AppIsland from '../islands/AppIsland.vue';
import { getSiteConfig } from '../lib/site-config';
import {
  fontStack,
  DEFAULT_FONTS,
  DEFAULT_CATEGORY,
  type FontConfigLike,
} from '../utils/font-stack';
import { resolveFaviconBase } from '../utils/favicon-base';
import { buildDefaultFaviconLinks, renderFaviconLinkTag } from '../utils/favicon-links';

interface Props {
  title: string;
  description?: string;
  conceptTerm?: string;
  conceptDefinition?: string;
}

const { title, description = '', conceptTerm, conceptDefinition } = Astro.props;
const siteConfig = await getSiteConfig();

// Derive Google Fonts URL from siteConfig branding (build-time SSG).
// Includes every slot the consumer declared (title / heading / body / mono,
// plus the deprecated `header` alias). Falls back to the default
// DM Sans / DM Serif Display / JetBrains Mono when nothing is declared.
const brandingFonts = siteConfig?.branding?.fonts;
const headingFont = brandingFonts?.heading ?? brandingFonts?.header; // header = deprecated alias
const fontSlots = [
  brandingFonts?.title,
  headingFont,
  brandingFonts?.body,
  brandingFonts?.mono,
];
const fontParts: string[] = [];
for (const f of fontSlots) {
  if (f && (f as FontConfigLike).source === 'google' && (f as FontConfigLike).family) {
    const w = (f.weights || [400, 700]).join(';');
    fontParts.push(`family=${(f as FontConfigLike).family.replace(/ /g, '+')}:wght@${w}`);
  }
}
const fontsUrl = fontParts.length > 0
  ? `https://fonts.googleapis.com/css2?${fontParts.join('&')}&display=swap`
  : 'https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=DM+Serif+Display:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap';

// Build CSS font-family stacks via the shared SSOT. Consumers can pick
// any category for any slot — e.g. sans-serif title + serif heading —
// and the fallback chain follows the declared category.
const fontTitle = fontStack(brandingFonts?.title, DEFAULT_CATEGORY.title) ?? DEFAULT_FONTS.title;
const fontHeading = fontStack(headingFont, DEFAULT_CATEGORY.heading) ?? DEFAULT_FONTS.heading;
const fontBody = fontStack(brandingFonts?.body, DEFAULT_CATEGORY.body) ?? DEFAULT_FONTS.body;
const fontMono = fontStack(brandingFonts?.mono, DEFAULT_CATEGORY.mono) ?? DEFAULT_FONTS.mono;

// Favicon configuration (issue #173).
//
// Consumers provide their own favicon set in one of two ways:
//
//   1. Drop canonical files at `branding.favicon.source_dir` (relative
//      to the consumer's cwd). The CLI's existing favicon step already
//      copies these into public/ overriding the defaults — this layout
//      just needs to emit the right <link> tags.
//
//   2. Set `branding.favicon.skip_default_links: true` and inject
//      custom <link> tags via the `branding.favicon.links_html`
//      string (e.g. RealFaviconGenerator output). The layout emits
//      that verbatim and skips the default tag block.
//
// When neither is set, today's default behavior is preserved.
const faviconCfg = siteConfig?.branding?.favicon ?? {};
const skipDefaultFaviconLinks = faviconCfg.skip_default_links === true;
const customFaviconLinks: string = faviconCfg.links_html ?? '';

// BASE_PATH-aware favicon URL prefix. Walks the configuration cascade:
// branding.favicon.base_path → siteConfig.basePath → import.meta.env.BASE_URL → '/'.
// Always ends with '/' so `${faviconBase}favicon.ico` resolves correctly
// whether the deployment is at '/' or '/cie-eilv/'.
//
// See src/utils/favicon-base.ts for the shared resolver + regression tests.
const faviconBaseInput = {
  brandingFaviconBasePath: typeof faviconCfg === 'object' ? faviconCfg.base_path : undefined,
  siteConfigBasePath: siteConfig?.basePath,
  astroBaseUrl: import.meta.env.BASE_URL,
};
const faviconBase = resolveFaviconBase(faviconBaseInput);
const faviconLinks = buildDefaultFaviconLinks(faviconBaseInput).map(renderFaviconLinkTag);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {!skipDefaultFaviconLinks && (
      <Fragment set:html={faviconLinks.join('\n    ')} />
    )}
    {customFaviconLinks && <Fragment set:html={customFaviconLinks} />}
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={siteConfig.title} />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href={fontsUrl} onload="this.rel='stylesheet'">
    <noscript><link href={fontsUrl} rel="stylesheet"></noscript>
    <Fragment set:html={`<style>:root{--font-title:${fontTitle};--font-heading:${fontHeading};--font-header:${fontHeading};--font-body:${fontBody};--font-mono:${fontMono}}</style>`} />
    <script is:inline>
      (function() {
        const c = document.cookie.split(';').map(s => s.trim()).find(s => s.startsWith('theme='));
        const t = c ? c.split('=')[1] : null;
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches))
          document.documentElement.classList.add('dark');
      })();
    </script>
  </head>
  <body class="bg-surface dark:bg-ink-900">
    <div id="app">
      <AppIsland client:only="vue" />
    </div>

    {conceptTerm && (
      <noscript>
        <div style="padding: 2rem; max-width: 800px; margin: 0 auto;">
          <h1>{conceptTerm}</h1>
          {conceptDefinition && <p>{conceptDefinition}</p>}
        </div>
      </noscript>
    )}
  </body>
</html>
