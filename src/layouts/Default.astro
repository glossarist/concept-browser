---
import '@/styles/tailwind.css';
import AppIsland from '../islands/AppIsland.vue';
import { getSiteConfig } from '../lib/site-config';

interface Props {
  title: string;
  description?: string;
  conceptTerm?: string;
  conceptDefinition?: string;
}

const { title, description = '', conceptTerm, conceptDefinition } = Astro.props;
const siteConfig = await getSiteConfig();

// Derive Google Fonts URL from siteConfig branding (build-time SSG).
// Falls back to the default DM Sans / DM Serif Display / JetBrains Mono
// when no branding.fonts is declared.
const brandingFonts = siteConfig?.branding?.fonts;
const fontParts: string[] = [];
if (brandingFonts?.header?.source === 'google' && brandingFonts.header.family) {
  const w = (brandingFonts.header.weights || [400, 700]).join(';');
  fontParts.push(`family=${brandingFonts.header.family.replace(/ /g, '+')}:wght@${w}`);
}
if (brandingFonts?.body?.source === 'google' && brandingFonts.body.family) {
  const w = (brandingFonts.body.weights || [400, 700]).join(';');
  fontParts.push(`family=${brandingFonts.body.family.replace(/ /g, '+')}:wght@${w}`);
}
const fontsUrl = fontParts.length > 0
  ? `https://fonts.googleapis.com/css2?${fontParts.join('&')}&display=swap`
  : 'https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=DM+Serif+Display:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap';

const fontHeader = brandingFonts?.header?.family
  ? `'${brandingFonts.header.family}', Georgia, serif`
  : `'DM Serif Display', Georgia, serif`;
const fontBody = brandingFonts?.body?.family
  ? `'${brandingFonts.body.family}', system-ui, sans-serif`
  : `'DM Sans', system-ui, sans-serif`;

// Favicon configuration (issue #173).
//
// Consumers provide their own favicon set in one of two ways:
//
//   1. Drop canonical files at `branding.favicon.source_dir` (relative
//      to the consumer's cwd). The CLI's existing favicon step already
//      copies these into public/ overriding the defaults — this layout
//      just needs to emit the right <link> tags.
//
//   2. Set `branding.favicon.skip_default_links: true` and inject
//      custom <link> tags via the `branding.favicon.links_html`
//      string (e.g. RealFaviconGenerator output). The layout emits
//      that verbatim and skips the default tag block.
//
// When neither is set, today's default behavior is preserved.
const faviconCfg = siteConfig?.branding?.favicon ?? {};
const skipDefaultFaviconLinks = faviconCfg.skip_default_links === true;
const customFaviconLinks: string = faviconCfg.links_html ?? '';
const faviconBase = faviconCfg.base_path ?? '/';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {!skipDefaultFaviconLinks && (
      <>
        <link rel="icon" type="image/x-icon" href={`${faviconBase}favicon.ico`} />
        <link rel="icon" type="image/svg+xml" href={`${faviconBase}favicon.svg`} />
        <link rel="icon" type="image/png" sizes="16x16" href={`${faviconBase}favicon-16x16.png`} />
        <link rel="icon" type="image/png" sizes="32x32" href={`${faviconBase}favicon-32x32.png`} />
        <link rel="icon" type="image/png" sizes="48x48" href={`${faviconBase}favicon-48x48.png`} />
        <link rel="apple-touch-icon" sizes="57x57" href={`${faviconBase}apple-touch-icon-57x57.png`} />
        <link rel="apple-touch-icon" sizes="60x60" href={`${faviconBase}apple-touch-icon-60x60.png`} />
        <link rel="apple-touch-icon" sizes="72x72" href={`${faviconBase}apple-touch-icon-72x72.png`} />
        <link rel="apple-touch-icon" sizes="76x76" href={`${faviconBase}apple-touch-icon-76x76.png`} />
        <link rel="apple-touch-icon" sizes="114x114" href={`${faviconBase}apple-touch-icon-114x114.png`} />
        <link rel="apple-touch-icon" sizes="120x120" href={`${faviconBase}apple-touch-icon-120x120.png`} />
        <link rel="apple-touch-icon" sizes="144x144" href={`${faviconBase}apple-touch-icon-144x144.png`} />
        <link rel="apple-touch-icon" sizes="152x152" href={`${faviconBase}apple-touch-icon-152x152.png`} />
        <link rel="apple-touch-icon" sizes="167x167" href={`${faviconBase}apple-touch-icon-167x167.png`} />
        <link rel="apple-touch-icon" sizes="180x180" href={`${faviconBase}apple-touch-icon-180x180.png`} />
        <link rel="apple-touch-icon" sizes="1024x1024" href={`${faviconBase}apple-touch-icon-1024x1024.png`} />
      </>
    )}
    {customFaviconLinks && <Fragment set:html={customFaviconLinks} />}
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={siteConfig.title} />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href={fontsUrl} onload="this.rel='stylesheet'">
    <noscript><link href={fontsUrl} rel="stylesheet"></noscript>
    <Fragment set:html={`<style>:root{--font-header:${fontHeader};--font-body:${fontBody}}</style>`} />
    <script is:inline>
      (function() {
        const c = document.cookie.split(';').map(s => s.trim()).find(s => s.startsWith('theme='));
        const t = c ? c.split('=')[1] : null;
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches))
          document.documentElement.classList.add('dark');
      })();
    </script>
  </head>
  <body class="bg-surface dark:bg-ink-900">
    <div id="app">
      <AppIsland client:only="vue" />
    </div>

    {conceptTerm && (
      <noscript>
        <div style="padding: 2rem; max-width: 800px; margin: 0 auto;">
          <h1>{conceptTerm}</h1>
          {conceptDefinition && <p>{conceptDefinition}</p>}
        </div>
      </noscript>
    )}
  </body>
</html>
